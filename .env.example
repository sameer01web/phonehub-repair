# =============================================================================
# Phone Hub - Single-Shop Repair & Resale Operations
# Environment Configuration Template
# =============================================================================
# Instructions:
# 1. Copy this file to '.env':
#    cp .env.example .env
# 2. Fill in your project URL and public anon key from your Supabase Dashboard:
#    Supabase Dashboard -> Project Settings -> API
# 3. NEVER commit your actual '.env' or service_role secret keys to Git/GitHub.
# =============================================================================

# Supabase Configuration (Vite Frontend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key-here

# Secondary Compatibility Keys (Optional Next.js / Client adapters)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key-here
